/* 用户数据与敏感信息（含登录态 cookie、AI Key）——绝不入库 */
data/
data.bak*
*.zip

/* 依赖 */
node_modules/

/* 测试与截图产物 */
_shots/
_shots-tmp-gzh/

/* 导出工具与产物（GitHub 上直接看仓库，无需离线导出包） */
_export/

/* 临时文件 */
settings-full.png
*.log
.DS_Store
Thumbs.db

/* 快捷方式：里面写的是本机绝对路径（node_modules/electron/dist/electron.exe），
   换机器就失效 —— 用 npm run make:lnk 现场生成，不入库 */
*.lnk

/* 编辑器 */
.vscode/
.idea/

/* 工作区内部笔记 */
.workbuddy/

/* 打包产物（进 GitHub Releases，不入库） */
dist/
